{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"baseUrl": ".",
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"$a": ["src/lib/components/atoms"],
			"$a/*": ["src/lib/components/atoms/*"],
			"$m": ["src/lib/components/molecules"],
			"$m/*": ["src/lib/components/molecules/*"],
			"$o": ["src/lib/components/organisms"],
			"$o/*": ["src/lib/components/organisms/*"],
			"$s": ["src/lib/components/special"],
			"$s/*": ["src/lib/components/special/*"],
			"$components": ["src/lib/components"],
			"$components/*": ["src/lib/components/*"],
			"$functions": ["src/lib/functions"],
			"$functions/*": ["src/lib/functions/*"],
			"$lib": ["src/lib"],
			"$lib/*": ["src/lib/*"],
			"$settings": ["src/lib/settings"],
			"$settings/*": ["src/lib/settings/*"],
			"$stores": ["src/lib/stores"],
			"$stores/*": ["src/lib/stores/*"],
			"$types": ["src/lib/types"],
			"$types/*": ["src/lib/types/*"],
		},
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
	}
}

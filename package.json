{
	"name": "lj-website",
	"private": true,
	"version": "0.20.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"format": "bunx biome format --write .",
		"lint": "bunx biome lint --write .",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "varlock codegen && svelte-kit sync || echo ''",
		"check": "varlock codegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "varlock codegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@iconify-json/ph": "^1.2.2",
		"@sveltejs/adapter-vercel": "7.0.3",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/bun": "^1.4.4",
		"@unocss/extractor-svelte": "66.12.0",
		"@unocss/preset-wind4": "66.12.0",
		"@varlock/vite-integration": "1.5.5",
		"@vercel/config": "0.14.1",
		"@vitest/coverage-v8": "5.1.0",
		"happy-dom": "^21.0.4",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "^6.0.3",
		"unocss": "66.12.0",
		"vite": "8.3.7",
		"vitest": "5.1.0"
	},
	"dependencies": {
		"@ai-sdk/gateway": "^4.0.139",
		"@ai-sdk/svelte": "^5.0.166",
		"@modelcontextprotocol/server": "^2.4.0",
		"@opentelemetry/api": "^1.10.0",
		"@sentry/sveltekit": "11.11.0",
		"@varlock/1password-plugin": "2.0.6",
		"ai": "^7.0.166",
		"marked": "^18.2.0",
		"marked-footnote": "^1.4.0",
		"mcp-handler": "2.3.1",
		"varlock": "1.24.0",
		"yaml": "2.9.1",
		"zod": "^4.6.7"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	],
	"imports": {
		"#lib/*.js": [
			"./src/lib/*.ts",
			"./src/lib/*.js"
		],
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"bun": "1.x",
		"node": "24.x"
	}
}

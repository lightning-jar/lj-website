# @defaultSensitive=false @defaultRequired=infer
# @generateTypes(lang=ts, path=src/env.d.ts)
# @envFlag=VERCEL_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=false)
# @setValuesBulk(opLoadEnvironment($OP_ENV_ID))
# ---

# =============================================================================
# BOOTSTRAP (literals — must resolve before the 1Password plugin runs)
# =============================================================================

# @required @type=opServiceAccountToken
# 1Password service account token. Locally, set this in .env.local (gitignored).
# On Vercel, set it as a Project Environment Variable scoped to Preview + Production.
OP_TOKEN=

# @required
# 1Password environment ID — selects which lj-website environment to load.
# Local dev: the lj-website dev environment id. Vercel production should
# override to the prod environment id.
OP_ENV_ID=

# Vercel deployment environment (development, preview, production).
# Injected by Vercel at runtime; set locally via `vercel env pull`.
# @required @type=enum(development, preview, production)
VERCEL_ENV=

# Production URL for the Vercel project (no protocol).
# Used to build canonical URLs in the sitemap and layout.
# @required @type=string
# @example=www.lightningjar.com
VERCEL_PROJECT_PRODUCTION_URL=

# Shared secret for the replicator blog CMS public API, sent as
# `x-api-key`. The same value lives on the Lightning Jar blog row in
# slx-replicator (managed at /org-settings/blog).
# Value loads from the 1Password environment ($OP_ENV_ID).
# @required @sensitive @type=string(startsWith="blogk_")
BLOG_API_KEY=

# Base URL for the slx-replicator deployment serving the blog CMS API.
# Blog routes are prerendered, so this is fetched at BUILD time.
# Value loads from the 1Password environment ($OP_ENV_ID).
# @required @type=url
# @example=https://replicator.securelogix.dev
BLOG_CMS_BASE_URL=

# Sentry source-map upload auth token. Build-time only.
# Value loads from the 1Password environment ($OP_ENV_ID).
# @sensitive @type=string(startsWith="sntrys_")
SENTRY_AUTH_TOKEN=

# Vercel OIDC token. Injected per-deploy by the platform.
# @sensitive
VERCEL_OIDC_TOKEN=
